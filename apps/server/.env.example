# Example env file for development — DO NOT commit real secrets
# Copy to .env and fill values locally. Add .env to .gitignore.

# JWT
JWT_SECRET=

# Uploads
# Absolute path to base dir (optional). If not set, repository's uploads/ is used.
UPLOAD_ABS_DIR=
UPLOAD_BASE_URL=
UPLOAD_MAX_FILE_MB=30
# Gallery video hard limit: 100 GiB. Large files use direct object-storage multipart upload.
UPLOAD_MAX_VIDEO_MB=102400
UPLOAD_THUMB_MAX_WIDTH=800
UPLOAD_THUMB_JPEG_QUALITY=80
UPLOAD_CACHE_CONTROL=public, max-age=31536000, immutable
PHOTO_DELETE_MAX_IDS=200
PHOTO_ZIP_MAX_IDS=50
PHOTO_ZIP_REMOTE_TIMEOUT_MS=20000
PHOTO_ZIP_MAX_REMOTE_BYTES=1073741824
COS_SIGNED_UPLOAD_EXPIRES_SECONDS=900
REQUEST_LOGS=1
# Search-quality logs: authenticated, authorized first-page searches only.
# Stored without account IDs, IPs, media URLs or vectors. App-only; proxy logs have their own policy.
SEARCH_TELEMETRY_ENABLED=1
SEARCH_TELEMETRY_RETENTION_DAYS=30
SEARCH_TELEMETRY_MAX_QUEUE=200
# Concurrent language-model query interpretations; overflow uses scoped local parsing.
AI_SEARCH_MAX_INFLIGHT=4
CORS_ORIGIN=http://localhost:5173

# Production video editor
# Must point outside the code deployment directory; only temporary FFmpeg inputs/outputs live here.
# Mac Mini example: /Users/<your-user>/mamage-data/video-work
VIDEO_WORK_DIR=/var/tmp/mamage-video-work
# Optional private remote whisper.cpp adapter; model assets stay on that host.
# VIDEO_TRANSCRIPT_SERVICE_URL=http://inference.internal:8009
# VIDEO_TRANSCRIPT_SERVICE_TOKEN=use-a-separate-long-random-secret
VIDEO_WORK_MAX_AGE_MS=86400000
VIDEO_UPLOAD_MAX_MB=102400
# The server-disk fallback is intentionally limited; files above this size must go direct to storage.
VIDEO_API_FALLBACK_MAX_MB=5120
# Large gallery videos use multipart direct upload; small videos keep presigned POST compatibility.
DIRECT_VIDEO_MULTIPART_THRESHOLD_MB=2048
DIRECT_VIDEO_PART_SIZE_MB=32
# HTTPS pages cannot PUT to an HTTP object-storage endpoint (browser mixed-content block),
# and off-campus browsers cannot reach a private storage IP at all. Those clients fall back to
# the same-origin part-proxy channel: each part is PUT to /api/upload/video/direct/part-proxy/...
# and streamed into storage multipart by the server (never touching the local temp disk).
# Parts must stay below the Cloudflare free-plan ~100MB per-request cap and finish well under
# the 100s origin timeout on slow tunnels, hence the smaller default vs direct parts.
DIRECT_VIDEO_PROXY_PART_SIZE_MB=8
DIRECT_VIDEO_PROXY_MAX_INFLIGHT=4
DIRECT_VIDEO_SESSION_TTL_MINUTES=180
DIRECT_VIDEO_SESSION_TTL_MAX_MINUTES=2880
DIRECT_VIDEO_ESTIMATED_BYTES_PER_SECOND=786432
DIRECT_VIDEO_FINISHING_BUFFER_SECONDS=1800
# Direct browser uploads scale their signed-form lifetime by file size. These values
# assume a conservative 768 KiB/s connection and cap a single form at 48 hours.
VIDEO_DIRECT_UPLOAD_TTL_MINUTES=30
VIDEO_DIRECT_UPLOAD_MAX_EXPIRES_SECONDS=172800
VIDEO_DIRECT_UPLOAD_ESTIMATED_BYTES_PER_SECOND=786432
VIDEO_RENDER_CONCURRENCY=1
VIDEO_RENDER_RECOVER_ON_BOOT=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Email verification
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MaMage 图库 <no-reply@example.com>
EMAIL_CODE_SECRET=
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_PER_HOUR=5
EMAIL_CODE_MAX_ATTEMPTS=5

# Tencent COS (optional)
COS_SECRET_ID=TCLOUD_SECRET_ID_PLACEHOLDER
COS_SECRET_KEY=TCLOUD_SECRET_KEY_PLACEHOLDER
COS_BUCKET=your-cos-bucket-name
COS_REGION=ap-beijing
COS_BASE_URL=https://your-bucket.cos.ap-beijing.myqcloud.com
# S3/Ceph endpoints addressed by IP normally require path-style bucket URLs.
COS_FORCE_PATH_STYLE=1
# Browser playback is served through the authenticated/signed same-origin media proxy.
IMAGE_PROXY_KEY_PREFIXES=uploads/
MEDIA_URL_SIGNING=1
MEDIA_URL_SECRET=
MEDIA_URL_TTL_DAYS=8
# For an internal S3/Ceph endpoint whose HTTPS certificate cannot be verified.
# This affects only the object-storage client; prefer a valid CA certificate in production.
# COS_TLS_REJECT_UNAUTHORIZED=0

# AI keys and models
# Text model configuration (AI 写稿使用)
# - Set either `OPENAI_API_KEY` (OpenAI-compatible) or `AI_TEXT_API_KEY` to enable
#   the news writer. Use `AI_TEXT_MODEL` or `OPENAI_MODEL` to choose the model name.
OPENAI_API_KEY=
AI_TEXT_API_KEY=
AI_TEXT_BASE_URL=
AI_TEXT_MODEL=
OPENAI_MODEL=
AI_VIDEO_MODEL=
VIDEO_AI_REQUIRE_MODEL=0

# Vision provider keys / model names
# - Set `AI_VISION_API_KEY` for vision calls and `AI_VISION_MODEL` for the model name.
AI_VISION_API_KEY=
AI_VISION_MODEL=
# Person-bound visual search is opt-in. Enable a user allowlist before wider rollout.
SEARCH_VISUAL_ENABLED=0
SEARCH_VISUAL_USER_IDS=
SEARCH_VISUAL_MODEL_REVISION=
SEARCH_VISUAL_CANDIDATE_LIMIT=128
SEARCH_VISUAL_TIMEOUT_MS=45000
SEARCH_VISUAL_ENQUEUE_ENABLED=1
# Generic scene/action verification is experimental; keep off until independently evaluated.
SEARCH_VISUAL_SEMANTIC_ENABLED=0
# Requires 20261016_001_photo_person_observations.sql. Adds low-priority face-bound descriptions;
# names remain in the person library, and the face-search grant still controls access.
PHOTO_PERSON_OBSERVATIONS_ENABLED=0
# Optional override for vision model used by ai_for_tags (defaults to qwen2-vl-72b-instruct)
# Note: `VISION_MODEL` is deprecated; use `AI_VISION_MODEL` instead.

# Face detector (optional, used by /api/faces/detect when no faces payload provided)
# FACE_DETECTOR_BACKEND=auto|insightface|opencv_haar
FACE_DETECTOR_BACKEND=auto
FACE_DETECTOR_MODEL_NAME=buffalo_sc
FACE_DETECTOR_PYTHON_PATH=python
FACE_DETECTOR_SCRIPT_PATH=
FACE_DETECTOR_TIMEOUT_MS=45000
FACE_DETECTOR_FETCH_TIMEOUT_MS=20000
FACE_DETECTOR_MAX_IMAGE_BYTES=15728640
FACE_DETECTOR_USE_THUMB=0
FACE_DETECTOR_USE_SERVICE=1
FACE_DETECTOR_SERVICE_URL=http://127.0.0.1:8009
FACE_DETECTOR_SERVICE_TIMEOUT_MS=20000
FACE_DETECTOR_SERVICE_REQUIRED=0
FACE_AUTO_WORKER_CONCURRENCY=1
FACE_AUTO_USE_BULLMQ=0
FACE_AUTO_WORKER_ENABLE=1
FACE_AUTO_QUEUE_NAME=face-auto-jobs
REDIS_URL=
FACE_CLUSTER_MATCH_THRESHOLD=0.36
FACE_CLUSTER_WEAK_THRESHOLD=0.28
FACE_CLUSTER_MATCH_MARGIN=0.06
# Find-me uses the same ambiguity guard; override only after evaluating labeled queries.
FACE_FIND_ME_THRESHOLD=0.36
FACE_FIND_ME_MATCH_MARGIN=0.06
# Optional scene/seat prior is disabled by default and never lowers the face threshold.
FACE_BURST_PRIOR=0
FACE_CLUSTER_TOPK=5
FACE_CLUSTER_AUTO_CREATE_PERSON=1
FACE_CLUSTER_CANDIDATE_LIMIT=5000
FACE_CLUSTER_UNIQUE_PERSON_PER_PHOTO=1
# 人物拆分（"系统认错人了？"）：脸贴近种子组需领先多少相似度才跟着搬走（默认 0.03）
FACE_SPLIT_ASSIGN_MARGIN=0.03

# Image similarity embedding worker concurrency (1-4, default 1)
IMAGE_SIMILARITY_CONCURRENCY=1
# Only compatibility images on legacy x86 CPUs use generic; normal deployments keep optimized kernels.
IMAGE_SIMILARITY_CPU_BACKEND=

# Public demo scope (optional)
# When frontend requests /api/projects/* with ?demo=1 and user is not logged in,
# backend will use this organization id for read-only demo access.
DEMO_ORGANIZATION_ID=

# MySQL database connection
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=200

# ===== 钉钉登录（企业内应用 OAuth；四项配齐即激活，前端按钮自动出现）=====
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# 回调地址需与钉钉开放平台配置完全一致
# MAMAGE_PUBLIC_URL=https://gallery.example.edu.cn
# DINGTALK_REDIRECT_URI=https://gallery.example.edu.cn/api/auth/dingtalk/callback
# 新用户自动建号归属的组织 id（不配则只允许已绑定/邮箱匹配的用户登录）
# DINGTALK_DEFAULT_ORG_ID=
# DINGTALK_DEFAULT_ROLE=visitor

# School IAM OAuth login (IAM already connects to DingTalk). Off until school registration is complete.
IAM_ENABLED=0
IAM_PUSH_ENABLED=0
# Keep this enabled after managing IAM accounts, even if login/push are temporarily switched off.
IAM_ACCOUNT_GUARD=0
# MAMAGE_PUBLIC_URL=https://photos.school.example.edu.cn
# IAM_BASE_URL=https://iam.school.example.edu.cn
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=
IAM_ORGANIZATION_ID=
# Must be the stable identifier matching the pushed account's externalId, never a display name.
IAM_PROFILE_ID_PATH=attributes.externalId
IAM_PKCE_ENABLED=1
# Unbound accounts are denied by default; opt-in provisioning creates visitors, without group grants.
IAM_AUTO_PROVISION=0
# Optional separate push credentials. Otherwise the OAuth application credentials are reused.
IAM_PUSH_APP_ID=
IAM_PUSH_APP_SECRET=
# SDK 3.8.0 AES derives its key from lowercase MD5 hex of the secret; also supports sdk-sm4 / aes-raw.
IAM_PUSH_CIPHER=sdk-aes
# Explicit IAM egress IPs/CIDRs. Forwarded client addresses are accepted only through trusted proxies.
IAM_PUSH_SOURCE_ADDRESSES=
IAM_TRUSTED_PROXY_ADDRESSES=
IAM_NAME_ATTRIBUTE=name
IAM_EMAIL_ATTRIBUTE=email
IAM_STUDENT_ATTRIBUTE=studentNo
# Optional root redirect for an IAM application registered against the website homepage.
IAM_REDIRECT_URI=
# Deliberate LAN-only exception; must exactly equal the private IPv4 HTTP public origin.
# Leave empty for the HTTPS default. Never applies to the IAM provider URL.
IAM_ALLOW_INSECURE_HTTP_ORIGIN=
# Match unique existing accounts using trusted name + email/student number; no local login allowlist.
IAM_PROFILE_LOGIN_MATCHING=0
# Set only when the IAM profile subject itself is a managed school email address.
IAM_SUBJECT_EMAIL_DOMAIN=

# Only enable the operations monitor on the background coordinator.
# OPERATIONS_MONITOR_ENABLED=1
# MAMAGE_RELEASE_SHA=full-committed-revision
# Backups use a separately mounted key, never a key in the runtime Secret.
# MAMAGE_BACKUP_KEY_FILE=/run/backup-key/key
# MAMAGE_BACKUP_PREFIX=backups/mamage/
AI_SEARCH_TIMEOUT_MS=20000  # 智能搜索模型解析超时；Pro 模型通常需 5-10s，默认 7s 偏紧
# Container/process lifecycle. Health probes do not call AI providers.
AI_VALIDATE_ON_STARTUP=0
SHUTDOWN_TIMEOUT_MS=55000
# Standalone compatibility mode. Helm forces 1; requires shared_runtime migration,
# one MySQL write primary and shared RWX volumes before running multiple replicas.
MAMAGE_DISTRIBUTED_RUNTIME=0
# Bounded shared-runtime concurrency; face/video lanes stay serial.
RUNTIME_VISION_CONCURRENCY=1
PUBLIC_DOWNLOAD_CONCURRENCY=1
RUNTIME_MAX_ACTIVE=6
RUNTIME_POLL_INTERVAL_MS=1000
# Pause new background dispatch under container/host memory or event-loop pressure.
RUNTIME_MEMORY_HIGH_MB=3072
RUNTIME_HOST_RESERVE_MB=1024

# Optional campus inference provider. Defaults preserve the current model services.
ZGCAI_BASE_URL=https://llm.inner.bza.edu.cn/hub
ZGCAI_API_KEY=
ZGCAI_VISION_MODEL=qwen
ZGCAI_TIMEOUT_MS=60000
# Set AI_VISION_PROVIDER=zgcai for photo semantics/scoring only.
# Pin VIDEO_SEMANTIC_VISION_PROVIDER separately; videos are not migrated by this adapter.
# Set SEARCH_VISUAL_PROVIDER=zgcai for person-bound clothing verification.
SEARCH_VISUAL_PROVIDER=ollama
# Changing provider/revision invalidates derived clothing evidence, not face identities.
# FACE_INFERENCE_PROVIDER=zgcai enables binary face/embed transport, not face/detect alone.
FACE_INFERENCE_PROVIDER=local
# Album/selfie dispatch stays blocked until compatibility with buffalo_l/null is approved.
# Standalone probe output remains in an isolated unverified space by default.
FACE_HUB_LEGACY_SPACE_APPROVED=0
