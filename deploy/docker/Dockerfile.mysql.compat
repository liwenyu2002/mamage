# syntax=docker/dockerfile:1
FROM mysql:9.6.0@sha256:c5df04bee1a42b74a5841c6409e669cf62126cd0416f00c1cea8ab933b9361b9 AS entrypoint
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
ARG MYSQL_VERSION=9.6.0
ARG MYSQL_SHA256=06ebd32ab32ccac2132c602ec3bfb4d5791b6ff9e98393b2fb04d1e97ff925b7
RUN test "$(dpkg --print-architecture)" = amd64 \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
       ca-certificates curl xz-utils gosu libaio1 libnuma1 libtinfo6 libncurses6 libssl3 tzdata \
    && curl -fL --retry 5 -o /tmp/mysql.tar.xz \
       "https://cdn.mysql.com/archives/mysql-9.6/mysql-${MYSQL_VERSION}-linux-glibc2.28-x86_64-minimal.tar.xz" \
    && echo "$MYSQL_SHA256  /tmp/mysql.tar.xz" | sha256sum -c - \
    && mkdir -p /usr/local/mysql \
    && tar -xJf /tmp/mysql.tar.xz --strip-components=1 -C /usr/local/mysql \
    && groupadd --gid 999 mysql \
    && useradd --uid 999 --gid mysql --home-dir /var/lib/mysql --no-create-home mysql \
    && mkdir -p /var/lib/mysql /var/lib/mysql-files /var/run/mysqld /etc/mysql/conf.d /docker-entrypoint-initdb.d \
    && chown mysql:mysql /var/lib/mysql /var/lib/mysql-files /var/run/mysqld \
    && chmod 1777 /var/run/mysqld \
    && rm -rf /tmp/mysql.tar.xz /var/lib/apt/lists/*
ENV PATH=/usr/local/mysql/bin:$PATH
COPY --from=entrypoint /usr/local/bin/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
COPY deploy/docker/mysql-compatible.cnf /etc/my.cnf
RUN mysqld --version && mysql --version
VOLUME ["/var/lib/mysql"]
EXPOSE 3306
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["mysqld"]
