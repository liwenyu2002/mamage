# syntax=docker/dockerfile:1
# Build the normal API image first, then supply that immutable local image here.
ARG API_IMAGE
FROM ${API_IMAGE} AS build
USER root
ARG VIPS_VERSION=8.18.7
ARG VIPS_SHA256=5baaead3b0bb20ffdb9e9ff09aa9fda08620923df77b63b436654cb5e0b3bf94
ENV CFLAGS="-O2 -march=x86-64 -mtune=generic" \
    CXXFLAGS="-O2 -march=x86-64 -mtune=generic" \
    PKG_CONFIG_PATH=/opt/vips/lib/pkgconfig \
    SHARP_FORCE_GLOBAL_LIBVIPS=1
RUN test "$(dpkg --print-architecture)" = amd64 \
    && apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
       build-essential meson ninja-build pkg-config curl xz-utils \
       libglib2.0-dev libexpat1-dev libjpeg62-turbo-dev libpng-dev libwebp-dev \
       libtiff-dev liblcms2-dev libexif-dev librsvg2-dev libpango1.0-dev \
       libimagequant-dev libcgif-dev libheif-dev libarchive-dev \
    && curl -fL --retry 5 -o /tmp/vips.tar.xz \
       "https://github.com/libvips/libvips/releases/download/v${VIPS_VERSION}/vips-${VIPS_VERSION}.tar.xz" \
    && echo "$VIPS_SHA256  /tmp/vips.tar.xz" | sha256sum -c - \
    && mkdir /tmp/vips \
    && tar -xJf /tmp/vips.tar.xz --strip-components=1 -C /tmp/vips \
    && meson setup /tmp/vips/build /tmp/vips --prefix=/opt/vips --libdir=lib \
       --buildtype=release --auto-features=disabled \
       -Dcplusplus=true -Dexamples=false -Dintrospection=disabled -Dmodules=disabled \
       -Djpeg=enabled -Dpng=enabled -Dwebp=enabled -Dtiff=enabled -Dheif=enabled \
       -Dexif=enabled -Dlcms=enabled -Drsvg=enabled -Dpangocairo=enabled \
       -Dfontconfig=enabled -Dimagequant=enabled -Dcgif=enabled -Darchive=enabled -Dzlib=enabled \
    && meson compile -C /tmp/vips/build -j 2 \
    && meson install -C /tmp/vips/build \
    && npm install --prefix /opt/sharp-build --no-audit --no-fund --ignore-scripts \
       node-gyp@12.2.0 node-addon-api@8.6.0 \
    && PATH="/opt/sharp-build/node_modules/.bin:$PATH" \
       NODE_PATH=/opt/sharp-build/node_modules npm_config_nodedir=/usr/local \
       npm run build --prefix /app/node_modules/sharp
ARG HEIF_VERSION=1.23.6
ARG HEIF_SHA256=4484346dc5995319dbc11e3a1c35d0a2ec46511ce370900869337fd2c7033125
RUN apt-get -o Acquire::Retries=5 install -y --no-install-recommends cmake libde265-dev \
    && curl -fL --retry 5 -o /tmp/heif.tar.gz \
       "https://github.com/strukturag/libheif/releases/download/v${HEIF_VERSION}/libheif-${HEIF_VERSION}.tar.gz" \
    && echo "$HEIF_SHA256  /tmp/heif.tar.gz" | sha256sum -c - \
    && mkdir /tmp/heif \
    && tar -xzf /tmp/heif.tar.gz --strip-components=1 -C /tmp/heif \
    && cmake -S /tmp/heif -B /tmp/heif/build -DCMAKE_BUILD_TYPE=Release \
       -DCMAKE_INSTALL_PREFIX=/opt/vips -DCMAKE_INSTALL_LIBDIR=lib \
       -DCMAKE_CXX_FLAGS="-march=x86-64 -mtune=generic" \
       -DWITH_EXAMPLES=OFF -DWITH_GDK_PIXBUF=OFF -DBUILD_TESTING=OFF \
       -DENABLE_PLUGIN_LOADING=OFF -DWITH_LIBSHARPYUV=OFF -DWITH_X264=OFF \
       -DWITH_LIBDE265=ON -DWITH_X265=ON -DWITH_AOM_DECODER=ON -DWITH_AOM_ENCODER=ON \
    && cmake --build /tmp/heif/build --parallel 2 \
    && cmake --install /tmp/heif/build \
    && rm -rf /tmp/vips/build \
    && meson setup /tmp/vips/build /tmp/vips --prefix=/opt/vips --libdir=lib \
       --buildtype=release --auto-features=disabled \
       -Dcplusplus=true -Dexamples=false -Dintrospection=disabled -Dmodules=disabled \
       -Djpeg=enabled -Dpng=enabled -Dwebp=enabled -Dtiff=enabled -Dheif=enabled \
       -Dexif=enabled -Dlcms=enabled -Drsvg=enabled -Dpangocairo=enabled \
       -Dfontconfig=enabled -Dimagequant=enabled -Dcgif=enabled -Darchive=enabled -Dzlib=enabled \
    && meson compile -C /tmp/vips/build -j 2 \
    && meson install -C /tmp/vips/build
FROM ${API_IMAGE}
USER root
RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
       libglib2.0-0 libexpat1 libjpeg62-turbo libpng16-16 libwebp7 libwebpmux3 libwebpdemux2 \
       libtiff6 liblcms2-2 libexif12 librsvg2-2 libpangocairo-1.0-0 libpangoft2-1.0-0 \
       libimagequant0 libcgif0 libheif1 libarchive13 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/vips/lib/ /opt/vips/lib/
COPY --from=build /opt/vips/share/ /opt/vips/share/
COPY --from=build --chown=node:node /app/node_modules/sharp/src/build/Release/ /app/node_modules/sharp/src/build/Release/
COPY --chown=node:node apps/server/scripts/resnet_feature.py apps/server/scripts/test_compatible_image_runtime.js apps/server/scripts/verify_container_runtime.js apps/server/scripts/run_migrations.js apps/server/scripts/test_migration_files.js /app/scripts/
RUN find /app -type f -name '._*' -delete
ENV LD_LIBRARY_PATH=/opt/vips/lib \
    IMAGE_SIMILARITY_CPU_BACKEND=generic
USER node
RUN node -e 'const sharp=require("sharp"); if(sharp.versions.vips!=="8.18.7")process.exit(1); console.log(sharp.versions)'
