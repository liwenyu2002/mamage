# Use only a previously verified native-compatible API image, pinned by digest.
ARG API_IMAGE
FROM ${API_IMAGE}
USER root
RUN node -e 'require("fs").writeFileSync("/tmp/sharp-version",require("./node_modules/sharp/package.json").version)'
COPY apps/server/package.json apps/server/package-lock.json /tmp/next-package/
RUN node -e 'if(require("/tmp/next-package/package-lock.json").packages["node_modules/sharp"].version!==require("fs").readFileSync("/tmp/sharp-version","utf8"))throw Error("Rebuild native compatibility for changed Sharp")'
RUN rm -rf /app/lib /app/routes /app/scripts /app/ai_function /app/config
COPY --chown=node:node apps/server/ /app/
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund \
    && chown -R node:node /app \
    && rm -rf /tmp/next-package /tmp/sharp-version /root/.npm
USER node
