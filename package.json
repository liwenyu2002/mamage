{
  "name": "mamage",
  "version": "1.0.0",
  "private": true,
  "description": "MaMage web and API, independently built and released together",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "setup": "node scripts/workspace.cjs setup",
    "test": "node scripts/workspace.cjs test",
    "build": "npm --prefix apps/web run build",
    "dev": "WEBPACK_DEV_SERVER_PORT=5188 npm --prefix apps/web run dev:prod",
    "dev:api": "npm --prefix apps/server start",
    "deploy": "node scripts/deploy.cjs",
    "test:deploy": "node --test scripts/deploy.test.cjs scripts/deploy-kubernetes.test.cjs",
    "test:k8s": "node --test scripts/kubernetes.test.cjs",
    "test:workspace:isolated": "node scripts/verify-workspace-db.cjs",
    "test:k8s:smoke": "node scripts/verify-kubernetes.cjs"
  }
}
